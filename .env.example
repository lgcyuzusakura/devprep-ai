# Set these in your shell before starting. The app does not load .env files.
# The provider reads only the variable named by its env_key field.
# Never commit real credentials.
OPENAI_API_KEY=

# Optional overrides. The app binds to localhost by default.
# DEVPREP_HOST=127.0.0.1
# DEVPREP_PORT=8765
# DEVPREP_CONFIG_FILE=
# DEVPREP_DB_FILE=
# DEVPREP_DATA_DIR=
# DEVPREP_LOCAL_LEARNING_FILE=
# The Node launcher prefers .cache/content/local.learning.zh-CN.json,
# then local.learning.json and devops.learning.json.
# Use --builtin-only to skip importing packs. Existing imported questions remain in the database.

# H2 uses a file basename without .mv.db. Default: ~/.devprep-ai/devprep
# For PostgreSQL, activate the postgres profile and set the connection details.
# SPRING_PROFILES_ACTIVE=postgres
# DEVPREP_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/devprep
# DEVPREP_DATABASE_USER=devprep
# DEVPREP_DATABASE_PASSWORD=
